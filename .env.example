# Server Configuration
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas URL)
# Example Local: mongodb://127.0.0.1:27017/logmonitor
# Example Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/logmonitor?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/logmonitor

# API Key used by Agents to authenticate POST /api/logs
API_KEY=log-monitor-secret-key-2026

# Retention policy: Logs older than N days are deleted automatically via MongoDB TTL index
LOG_RETENTION_DAYS=7

# How often the alert engine evaluates active rules (in seconds)
ALERT_CHECK_INTERVAL_SECONDS=15
